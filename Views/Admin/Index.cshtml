@model Deliverable_2_StudentBookExchangeMVC.Models.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="page-heading mb-4">
    <div>
        <span class="eyebrow">CONTROL CENTER</span>
        <h1 class="fw-bold mb-1">Admin Dashboard</h1>
        <p class="text-muted mb-0">Monitor listings and manage the Student Book Exchange platform.</p>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="stat-card"><span>Total book listings</span><strong>@Model.TotalBooks</strong></div></div>
    <div class="col-md-4"><div class="stat-card"><span>Available books</span><strong>@Model.AvailableBooks</strong></div></div>
    <div class="col-md-4"><div class="stat-card"><span>Registered users</span><strong>@Model.TotalUsers</strong></div></div>
</div>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card app-card h-100"><div class="card-body p-4">
            <h4>Manage Books</h4><p class="text-muted">Review, edit, and remove book listings.</p>
            <a asp-controller="Books" asp-action="Index" class="btn btn-primary">View Books</a>
        </div></div>
    </div>
    <div class="col-md-6">
        <div class="card app-card h-100"><div class="card-body p-4">
            <h4>User Management</h4><p class="text-muted">View registered users and assign Student or Admin roles.</p>
            <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-primary">Manage Users</a>
        </div></div>
    </div>
</div>
