@model IEnumerable<Deliverable_2_StudentBookExchangeMVC.Models.Book>
@if (!Model.Any())
{
    <div class="empty-state"><div class="display-5">📚</div><h4>No books found</h4><p class="text-muted">Try a different search term or add the first listing.</p></div>
}
else
{
    <div class="row g-3">
    @foreach (var book in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card app-card h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between gap-2 mb-2">
                        <span class="badge bg-primary-subtle text-primary">@book.Subject</span>
                        <span class="badge @(book.IsAvailable ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                            @(book.IsAvailable ? "Available" : "Unavailable")
                        </span>
                    </div>
                    <h5 class="fw-bold">@book.Title</h5>
                    <p class="text-muted mb-2">by @book.Author</p>
                    <p class="small text-muted">Condition: @book.Condition</p>
                    @if (!string.IsNullOrWhiteSpace(book.Description))
                    {
                        <p class="small flex-grow-1">@book.Description</p>
                    }
                    else { <div class="flex-grow-1"></div> }
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <strong class="fs-5 text-primary">Rs. @book.Price.ToString("N0")</strong>
                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">Details</a>
                    </div>
                    @if (User.IsInRole("Admin") || (User.Identity?.IsAuthenticated == true && book.SellerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
                    {
                        <div class="mt-3 d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-light">Edit</a>
                            <button type="button" class="btn btn-sm btn-outline-danger js-delete-book" data-id="@book.Id">Delete (AJAX)</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    </div>
}
