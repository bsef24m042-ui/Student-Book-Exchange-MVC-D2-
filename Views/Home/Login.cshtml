@model Deliverable_2_StudentBookExchangeMVC.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-4">

                    <h2 class="text-center mb-3">Welcome Back!</h2>

                    <p class="text-center text-muted">
                        Login to your Student Book Exchange account.
                    </p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    <form asp-controller="Home" asp-action="Login" method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                Email Address
                            </label>
                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter your email" />
                            <span asp-validation-for="Email"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                Password
                            </label>
                            <input asp-for="Password"
                                   class="form-control"
                                   placeholder="Enter your password" />
                            <span asp-validation-for="Password"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="RememberMe"
                                   class="form-check-input" />
                            <label asp-for="RememberMe"
                                   class="form-check-label">
                                Remember me
                            </label>
                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    class="btn btn-primary">
                                Login
                            </button>
                        </div>

                    </form>

                    <p class="text-center mt-3">
                        Don't have an account?
                        <a asp-controller="Home" asp-action="Signup">
                            Sign Up
                        </a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
